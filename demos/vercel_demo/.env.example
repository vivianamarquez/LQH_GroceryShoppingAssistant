# Server-only. The screenshot's key label is NOT the model deployment name.
LQH_INFERENCE_API_KEY=
LQH_DEPLOYMENT_NAME=

# Optional Kroger integration; enable product.compact and cart.basic:write.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Must exactly match the URL registered in your Kroger developer application.
KROGER_REDIRECT_URI=http://localhost:3000/api/kroger/callback

# Optional public HTTPS GGUF URL; defaults to the official, revision-pinned Q4 file.
# Must allow browser CORS downloads. Never put a token in this URL.
NEXT_PUBLIC_BASE_MODEL_URL=
